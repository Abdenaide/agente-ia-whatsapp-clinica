# Chave da API da Groq (obtenha gratuitamente em https://console.groq.com/keys)
GROQ_API_KEY=gsk_sua_chave_aqui

# Opcional: caminho do executável do Chrome/Chromium usado pelo Puppeteer.
# Exemplos:
#   Linux:  /usr/bin/google-chrome-stable
#   macOS:  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Se não for definido, o Puppeteer tenta encontrar o navegador automaticamente.
# CHROME_PATH=
